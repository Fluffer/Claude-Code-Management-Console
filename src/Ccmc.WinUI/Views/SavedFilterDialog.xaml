<ContentDialog x:Class="Ccmc.App.Views.SavedFilterDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:models="using:Ccmc.Core.Models"
               Title="Saved filters"
               PrimaryButtonText="Save"
               CloseButtonText="Cancel"
               DefaultButton="Primary">
    <Grid MinWidth="560" MinHeight="360" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Filter list + add/remove -->
        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListView x:Name="FilterList" Grid.Row="0" SelectionMode="Single"
                      AutomationProperties.AutomationId="FilterList"
                      SelectionChanged="FilterList_SelectionChanged"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      CornerRadius="{ThemeResource ControlCornerRadius}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SavedFilter">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="AddButton" Content="Add" MinWidth="92" Click="AddButton_Click"
                        AutomationProperties.AutomationId="AddFilterButton"
                        ToolTipService.ToolTip="Create a new saved filter"/>
                <Button x:Name="RemoveButton" Content="Remove" MinWidth="92" Click="RemoveButton_Click"
                        AutomationProperties.AutomationId="RemoveFilterButton"
                        ToolTipService.ToolTip="Delete the selected filter"/>
            </StackPanel>
        </Grid>

        <!-- Editing panel -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="EditorPanel" Spacing="12">
                <TextBox x:Name="NameBox" Header="Name"
                         AutomationProperties.AutomationId="FilterNameBox"
                         TextChanged="NameBox_TextChanged"
                         ToolTipService.ToolTip="A short name for this filter, shown as a sidebar entry"/>
                <TextBox x:Name="PathContainsBox" Header="Path contains"
                         AutomationProperties.AutomationId="FilterPathContainsBox"
                         TextChanged="PathContainsBox_TextChanged"
                         PlaceholderText="e.g. Active"
                         ToolTipService.ToolTip="Match only projects whose full path contains this text (case-insensitive). Leave blank to ignore."/>
                <CheckBox x:Name="RequireGitCheck" Content="Has a git repository"
                          AutomationProperties.AutomationId="FilterRequireGitCheck"
                          Click="Condition_Changed"
                          ToolTipService.ToolTip="Only show projects with a .git folder"/>
                <CheckBox x:Name="RequireClaudeMdCheck" Content="Has a CLAUDE.md"
                          AutomationProperties.AutomationId="FilterRequireClaudeMdCheck"
                          Click="Condition_Changed"
                          ToolTipService.ToolTip="Only show projects with a CLAUDE.md file"/>
                <CheckBox x:Name="RequireRunningCheck" Content="Has a live Claude session"
                          AutomationProperties.AutomationId="FilterRequireRunningCheck"
                          Click="Condition_Changed"
                          ToolTipService.ToolTip="Only show projects with a Claude session running right now"/>
                <CheckBox x:Name="RequirePinnedCheck" Content="Is pinned"
                          AutomationProperties.AutomationId="FilterRequirePinnedCheck"
                          Click="Condition_Changed"
                          ToolTipService.ToolTip="Only show pinned projects"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
