<ContentDialog x:Class="Ccmc.App.Views.EnvEditorDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:views="using:Ccmc.App.Views"
               Title="Edit .env"
               PrimaryButtonText="Save"
               CloseButtonText="Cancel"
               DefaultButton="Primary">
    <Grid RowSpacing="12" MinWidth="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Values are hidden. Use the eye button on a row to reveal it briefly."
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"/>

        <ListView Grid.Row="1"
                  x:Name="EntryList"
                  AutomationProperties.AutomationId="EnvEntryList"
                  ItemsSource="{x:Bind Rows}"
                  SelectionMode="None"
                  MaxHeight="320">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="views:EnvRowViewModel">
                    <Grid ColumnSpacing="8" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind Key}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind Key}"
                                   VerticalAlignment="Center"/>
                        <PasswordBox Grid.Column="1"
                                     AutomationProperties.Name="Value"
                                     Password="{x:Bind Value, Mode=TwoWay}"
                                     PasswordRevealMode="{x:Bind RevealMode, Mode=OneWay}"/>
                        <ToggleButton Grid.Column="2"
                                      AutomationProperties.AutomationId="RevealValueToggle"
                                      AutomationProperties.Name="Reveal value"
                                      ToolTipService.ToolTip="Reveal this value"
                                      IsChecked="{x:Bind IsRevealed, Mode=TwoWay}">
                            <FontIcon Glyph="&#xE7B3;" FontSize="14"/>
                        </ToggleButton>
                        <Button Grid.Column="3"
                                AutomationProperties.AutomationId="RemoveEnvKeyButton"
                                AutomationProperties.Name="Remove key"
                                ToolTipService.ToolTip="Remove this key"
                                Click="Remove_Click"
                                Tag="{x:Bind}">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     x:Name="NewKeyBox"
                     AutomationProperties.AutomationId="NewEnvKeyBox"
                     PlaceholderText="NEW_KEY"/>
            <TextBox Grid.Column="1"
                     x:Name="NewValueBox"
                     AutomationProperties.AutomationId="NewEnvValueBox"
                     PlaceholderText="value"/>
            <Button Grid.Column="2"
                    AutomationProperties.AutomationId="AddEnvKeyButton"
                    Content="Add key"
                    Click="Add_Click"/>
        </Grid>
    </Grid>
</ContentDialog>
