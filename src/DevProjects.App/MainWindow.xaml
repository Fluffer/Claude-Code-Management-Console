<Window x:Class="DevProjects.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DevProjects.App"
        xmlns:vm="clr-namespace:DevProjects.App.ViewModels"
        Title="Dev-Projects" Height="680" Width="1000" MinHeight="480" MinWidth="760"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver" DragLeave="Window_DragLeave">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FocusSearchCmd}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static local:MainWindow.NewProjectCmd}"/>
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.RefreshCmd}"/>
        <KeyBinding Key="F1" Command="{x:Static local:MainWindow.HelpCmd}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Warning banner: claude not on PATH -->
        <Border Grid.Row="0" Background="#FFF3CD" Padding="10,8"
                Visibility="{Binding ClaudeMissing, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="#7A5C00" TextWrapping="Wrap"
                       Text="'claude' was not found on PATH. Sessions will open a terminal, but the claude command will fail. Install Claude Code or fix PATH, then press Refresh (F5)."/>
        </Border>

        <!-- First-run onboarding -->
        <!-- #30808080 = translucent grey that reads correctly on light AND dark themes -->
        <Border Grid.Row="1" Padding="12,10" CornerRadius="6" Margin="10,8,10,0"
                Background="#30808080"
                Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Got it" Margin="8,0,0,0" Padding="12,4"
                        VerticalAlignment="Center" Command="{Binding DismissOnboardingCommand}"
                        ToolTip="Hide this introduction (you can reopen the full guide with F1)"/>
                <Button DockPanel.Dock="Right" Content="Open guide" Padding="12,4"
                        VerticalAlignment="Center" Click="HelpButton_Click"
                        ToolTip="Open the full help guide (F1)"/>
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run FontWeight="SemiBold" Text="Welcome to Dev-Projects!"/>
                    <Run Text=" Pick a project and press Enter to continue its last Claude session, or Ctrl+Enter for a fresh one. Filter by folder on the left, search with Ctrl+F, pin favourites with ☆, and press F1 anytime for the full guide."/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <DockPanel Grid.Column="0" Margin="8,0,0,8" LastChildFill="True">
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="0,6"/>
                    <DockPanel Margin="0,0,0,6"
                               ToolTip="Choose the app colour theme. 'System' follows your Windows light/dark setting.">
                        <TextBlock Text="Theme" VerticalAlignment="Center" DockPanel.Dock="Left"
                                   Margin="4,0,8,0" Opacity="0.8"/>
                        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"/>
                    </DockPanel>
                    <Button Content="⚙  Settings" HorizontalAlignment="Stretch" Padding="8,6"
                            Click="SettingsButton_Click"
                            ToolTip="Manage source roots and the default folder for new projects"/>
                    <Button Content="？ Help" HorizontalAlignment="Stretch" Padding="8,6" Margin="0,6,0,0"
                            Click="HelpButton_Click"
                            ToolTip="How everything works, including keyboard shortcuts (F1)"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="SOURCE ROOTS" Margin="6,2,0,6"
                           FontSize="11" Opacity="0.6"
                           ToolTip="Folders that are scanned for projects. Click one to filter the list."/>
                <ListBox ItemsSource="{Binding SidebarItems}" SelectedItem="{Binding SelectedSidebarItem}"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Content -->
            <DockPanel Grid.Column="1" Margin="8,0,10,8">

                <!-- Search + sort -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="SearchBox" Padding="6,5"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Type to filter projects by name. Ctrl+F focuses this box; Esc clears it."/>
                        <TextBlock Text="🔍 Search projects   (Ctrl+F)" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Opacity="0.5" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox x:Name="SortCombo" Grid.Column="1" Margin="8,0,0,0" MinWidth="170"
                              SelectionChanged="SortCombo_SelectionChanged"
                              ToolTip="Change how the project list is ordered. Pinned projects always stay on top.">
                        <ComboBoxItem Content="Sort: Recently used" Tag="LastUsed"/>
                        <ComboBoxItem Content="Sort: Name A–Z" Tag="Name"/>
                    </ComboBox>
                </Grid>

                <!-- Flags row -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Flags:" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="Extra command-line flags passed to claude when launching the selected project."/>
                    <TextBox Grid.Column="1" Padding="6,5"
                             Text="{Binding FlagsText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding FlagsEnabled}"
                             ToolTipService.ShowOnDisabled="True">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="ToolTip"
                                        Value="Flags for the selected project, e.g. --model opus. Saved automatically as you type; used by both New and Continue."/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="ToolTip"
                                                Value="Select a project first, then add flags here (e.g. --model opus)."/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button x:Name="AddFlagButton" Grid.Column="2" Content="＋ Flag" Margin="8,0,0,0" Padding="10,5"
                            IsEnabled="{Binding FlagsEnabled}" Click="AddFlagButton_Click"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Insert a common claude flag with an explanation of what it does"/>
                </Grid>

                <!-- Bottom action bar -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
                    <Button Content="＋ New Project" Padding="12,6" DockPanel.Dock="Left"
                            Click="NewProjectButton_Click"
                            ToolTip="Create a new empty project folder and (optionally) start Claude in it (Ctrl+N)"/>
                    <Button Content="⟳ Refresh" Padding="12,6" Margin="8,0,0,0" DockPanel.Dock="Left"
                            Command="{Binding RescanCommand}"
                            ToolTip="Rescan the source roots now (F5). The list also refreshes automatically when folders change."/>
                </DockPanel>

                <!-- Project list -->
                <Grid>
                    <ListView x:Name="ProjectList" ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject}"
                              PreviewKeyDown="ProjectList_PreviewKeyDown"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <!-- Right-click selects the row, so context-menu actions target it. -->
                                <EventSetter Event="PreviewMouseRightButtonDown"
                                             Handler="ListViewItem_PreviewMouseRightButtonDown"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProjectItemViewModel}">
                                <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open in Explorer"
                                                      Command="{Binding PlacementTarget.Tag.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Open in VS Code"
                                                      Command="{Binding PlacementTarget.Tag.OpenInVsCodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding PlacementTarget.Tag.VsCodeAvailable, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"/>
                                            <MenuItem Header="Copy path"
                                                      Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="Rename…" Click="RenameMenuItem_Click"
                                                      ToolTip="Rename the project folder (config and pin follow the new name)"/>
                                            <MenuItem Header="Move to root" x:Name="MoveToRootMenu"
                                                      SubmenuOpened="MoveToRootMenu_SubmenuOpened"
                                                      ToolTip="Move the project folder to another source root, e.g. Archive or Stable">
                                                <MenuItem Header="(loading…)"/>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Pin / Unpin"
                                                      Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Pin -->
                                    <Button Grid.Column="0" Width="28" Height="28" Margin="0,0,6,0"
                                            Background="Transparent" BorderThickness="0"
                                            Command="{Binding Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Grid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding PinToolTip}">
                                        <TextBlock FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="☆"/>
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Text" Value="★"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Setter Property="Foreground" Value="#E8A33D"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <!-- Name + metadata -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                   VerticalAlignment="Center" ToolTip="{Binding Path}"/>
                                        <Border CornerRadius="9" Padding="8,2" Margin="10,0,0,0"
                                                VerticalAlignment="Center" Background="#2A6BC4" Opacity="0.85"
                                                ToolTip="{Binding Root}">
                                            <TextBlock Text="{Binding RootName}" FontSize="10" Foreground="White"/>
                                        </Border>
                                        <Border CornerRadius="9" Padding="7,2" Margin="8,0,0,0"
                                                VerticalAlignment="Center" Background="#1E7F45"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{Binding RunningToolTip}">
                                            <TextBlock Text="● live" FontSize="10" Foreground="White"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasGitInfo, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{Binding GitToolTip}">
                                            <TextBlock Text="⎇" FontSize="11" Opacity="0.7" Margin="0,0,3,0"/>
                                            <TextBlock Text="{Binding GitBranch}" FontSize="11" Opacity="0.7"/>
                                            <TextBlock Text=" ●" FontSize="10" Foreground="#E8A33D">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GitDirty}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LastUsedText}" Opacity="0.55" FontSize="11"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   ToolTip="When you last launched a Claude session here from this app"/>
                                    </StackPanel>

                                    <!-- Launch buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="New" Padding="14,4" Margin="0,0,6,0"
                                                Command="{Binding Tag.LaunchNewCommand, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Start a fresh Claude session in this project (Ctrl+Enter)"/>
                                        <Button Content="Continue" Padding="14,4"
                                                IsEnabled="{Binding HasSession}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="{Binding ContinueToolTip}"
                                                Command="{Binding Tag.LaunchContinueCommand, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state -->
                    <TextBlock Text="{Binding EmptyStateText}" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" Opacity="0.6"
                               Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Padding="10,6" BorderThickness="0,1,0,0"
                BorderBrush="#40808080">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding ClaudeVersionText}" Opacity="0.7" FontSize="11"
                           ToolTip="Version of the claude CLI found on PATH"/>
                <TextBlock DockPanel.Dock="Right" Opacity="0.7" FontSize="11"
                           Text="Enter = Continue · Ctrl+Enter = New · Ctrl+F = Search · F1 = Help"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Opacity="0.7" FontSize="11"/>
                    <TextBlock Text="{Binding RunningSummary}" Opacity="0.9" FontSize="11" Margin="6,0,0,0"
                               Foreground="#3CB371"
                               ToolTip="Projects with a claude process running in their folder right now (rechecked every 30 seconds)"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Drag-drop overlay -->
        <Border x:Name="DropOverlay" Grid.RowSpan="4" Background="#882A6BC4" Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border BorderBrush="White" BorderThickness="2" CornerRadius="10" Margin="40"
                    Background="#CC1E4E8F">
                <TextBlock Text="Drop a folder here&#10;Add it as a source root, or launch Claude in it"
                           Foreground="White" FontSize="18" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Border>

        <!-- Toast -->
        <Border x:Name="Toast" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,46" Padding="16,9" CornerRadius="8" Background="#DD333333"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="12"/>
        </Border>
    </Grid>
</Window>
