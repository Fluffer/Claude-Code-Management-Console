<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Dev-Projects</AssemblyName>
    <Version>2.0.0</Version>
    <!-- WPF0001: .NET 9 Fluent ThemeMode API is marked experimental; we opt in deliberately. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Icon extracted from the local claude.exe (official Claude Code starburst). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevProjects.Core\DevProjects.Core.csproj" />
  </ItemGroup>

</Project>
