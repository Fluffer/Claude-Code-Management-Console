<Window x:Class="DevProjects.App.Views.DropChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dropped Folder" Height="230" Width="480" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <TextBlock x:Name="FolderText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="What would you like to do with this folder?" Margin="0,0,0,12"/>
    <Button Content="Add as a source root" Padding="10,8" Margin="0,0,0,8" Click="AddRoot_Click"
            ToolTip="Scan this folder for projects from now on — each subfolder becomes a project entry"/>
    <Button Content="Launch Claude here (one-off)" Padding="10,8" Margin="0,0,0,8" Click="Launch_Click"
            ToolTip="Open a Windows Terminal tab running claude in this folder, without tracking it"/>
    <Button Content="Cancel" Padding="10,8" IsCancel="True"/>
  </StackPanel>
</Window>
