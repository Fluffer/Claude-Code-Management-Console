<Window x:Class="DevProjects.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="400" Width="540" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button Content="Close" Width="92" IsDefault="True" IsCancel="True"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock Text="Default root for new projects"
                 ToolTip="Preselected in the New Project dialog when 'All' is active in the sidebar"/>
      <ComboBox x:Name="DefaultCombo" Margin="0,6,0,0" SelectionChanged="DefaultCombo_SelectionChanged"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Margin="10,22,0,0">
      <Button x:Name="AddButton" Content="Add…" Width="92" Margin="0,0,0,8" Click="AddButton_Click"
              ToolTip="Pick a folder that contains your projects — each subfolder becomes a project entry"/>
      <Button x:Name="RemoveButton" Content="Remove" Width="92" Click="RemoveButton_Click"
              ToolTip="Stop scanning the selected root. Your folders and files are NOT deleted."/>
    </StackPanel>
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Source roots"
                 ToolTip="Folders scanned for projects. Each direct subfolder shows up in the project list."/>
      <ListBox x:Name="RootsList" Margin="0,6,0,0"/>
    </DockPanel>
  </DockPanel>
</Window>
