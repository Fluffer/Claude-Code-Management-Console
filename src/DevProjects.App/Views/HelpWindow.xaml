<Window x:Class="DevProjects.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev-Projects — Help" Height="620" Width="680" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <DockPanel Margin="0">
    <Border DockPanel.Dock="Bottom" Padding="16,10">
      <Button Content="Close" Width="92" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"/>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,12">
      <StackPanel MaxWidth="600">

        <TextBlock FontSize="20" FontWeight="SemiBold" Text="How Dev-Projects works" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,16"
                   Text="Dev-Projects is a launcher hub for Claude Code. It lists every project folder found under your source roots and opens Claude sessions in Windows Terminal tabs. The hub stays open, so you can launch as many sessions as you like."/>

        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Launching sessions" Margin="0,0,0,6"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="• New — starts a fresh Claude session in the project folder (runs: claude)."/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="• Continue — resumes the most recent session in that folder (runs: claude --continue). It is greyed out when no previous session exists for the folder."/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Text="• Each launch opens as a new tab in your existing Windows Terminal window, titled with the project name."/>

        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Sidebar — source roots" Margin="0,0,0,6"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Each entry is a folder that gets scanned for projects (every direct subfolder is one project). Click a root to filter the list, or 'All' to see everything. Greyed-out roots don't exist on disk right now. Manage roots in Settings."/>

        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Flags" Margin="0,0,0,6"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="The Flags box holds extra command-line options for the selected project — for example '--model opus'. Flags are saved per project as you type and are used by both New and Continue. The ＋ Flag button offers common flags with descriptions:"/>
        <ItemsControl x:Name="FlagList" Margin="8,0,0,16">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,6">
                <TextBlock FontFamily="Consolas" FontWeight="SemiBold" Text="{Binding Display}"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12" Text="{Binding Description}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Project rows" Margin="0,0,0,6"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="• ☆ pins a project to the top of the list."/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="• The coloured chip shows which root the project lives in."/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="• ⎇ shows the current git branch; an orange dot means uncommitted changes."/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="• A green 'live' badge means a Claude session is running there right now — a claude process with that folder as its working directory was detected. Updates every 30 seconds; the status bar shows the total count."/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Text="• Right-click a row for quick actions: Open in Explorer, Open in VS Code, Copy path, Rename, Move to another root (e.g. Archive or Stable), Pin/Unpin."/>

        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Renaming &amp; moving projects" Margin="0,0,0,6"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="• Rename… changes the folder name in place; Move to root relocates the folder to another source root (handy for archiving finished work or promoting it to Stable)."/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="• Saved flags, last-used time and pin status follow the project automatically."/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Text="• Claude session history is tied to the folder path, so Continue starts fresh after a rename/move (old transcripts are not deleted). Close any session running in the folder first, or the move will fail with a clear error."/>

        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Creating projects" Margin="0,0,0,6"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="＋ New Project creates an empty folder under a chosen root and can start Claude in it straight away. You can also drop any folder onto the window — it is added as a new source root or used for a one-off Claude launch."/>

        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Keyboard shortcuts" Margin="0,0,0,6"/>
        <Grid Margin="8,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            <RowDefinition/><RowDefinition/><RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" FontFamily="Consolas" Text="Enter"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="Continue the selected project's last session"/>
          <TextBlock Grid.Row="1" FontFamily="Consolas" Text="Ctrl+Enter"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="Start a new session in the selected project"/>
          <TextBlock Grid.Row="2" FontFamily="Consolas" Text="Ctrl+F"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="Focus the search box"/>
          <TextBlock Grid.Row="3" FontFamily="Consolas" Text="Esc"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="Clear the search"/>
          <TextBlock Grid.Row="4" FontFamily="Consolas" Text="Ctrl+N"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="New project dialog"/>
          <TextBlock Grid.Row="5" FontFamily="Consolas" Text="F5"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="Refresh the project list"/>
          <TextBlock Grid.Row="6" FontFamily="Consolas" Text="F1"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="This help window"/>
        </Grid>

        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Good to know" Margin="0,0,0,6"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="• The list refreshes automatically when folders are added or removed under a root."/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="• Settings are stored in %APPDATA%\Dev-Projects (config.json and state.json)."/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="• Removing a source root never deletes anything on disk — it only stops scanning."/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="• The status bar shows the claude CLI version that will be used for launches."/>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
