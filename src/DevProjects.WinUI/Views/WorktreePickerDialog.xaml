<ContentDialog x:Class="DevProjects.App.Views.WorktreePickerDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="Launch in worktree"
               PrimaryButtonText="Launch"
               CloseButtonText="Cancel"
               IsPrimaryButtonEnabled="False"
               DefaultButton="Primary">
    <ListView x:Name="WorktreeList"
              AutomationProperties.AutomationId="WorktreePickerList"
              SelectionMode="Single"
              MinWidth="460"
              MaxHeight="360"
              SelectionChanged="WorktreeList_SelectionChanged">
        <ListView.ItemTemplate>
            <DataTemplate>
                <Grid ColumnSpacing="8" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding Branch}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path}"
                                   Opacity="0.55"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</ContentDialog>
