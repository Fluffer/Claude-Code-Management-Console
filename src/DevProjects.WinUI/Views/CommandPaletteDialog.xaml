<ContentDialog x:Class="DevProjects.App.Views.CommandPaletteDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               CloseButtonText="Cancel">
    <StackPanel Spacing="8" MinWidth="460">
        <TextBox x:Name="QueryBox"
                 AutomationProperties.AutomationId="PaletteQueryBox"
                 PlaceholderText="Jump to project…  (Enter = continue, Ctrl+Enter = new)"
                 TextChanged="QueryBox_TextChanged"
                 KeyDown="QueryBox_KeyDown"/>
        <ListView x:Name="ResultsList"
                  AutomationProperties.AutomationId="PaletteResultsList"
                  SelectionMode="Single"
                  MaxHeight="360">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding RootName}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.6" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
