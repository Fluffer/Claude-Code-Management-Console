{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "out/main",
    "rootDir": ".",
    "types": ["electron-vite/node", "node"],
    "paths": {}
  },
  // main and preload both import from src/core and src/shared. Without those
  // here every such import is a TS6307 ("not listed within the file list of
  // project"), which drowns out real errors and made typecheck unusable.
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/core/**/*",
    "src/shared/**/*"
  ]
}
