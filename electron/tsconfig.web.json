{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "outDir": "out/renderer",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/*"]
    }
  },
  // The renderer imports core models/logic and the shared IPC contract, so both
  // must be part of this project or every import reports TS6307.
  "include": ["src/renderer/**/*", "src/core/**/*", "src/shared/**/*"]
}
